# ── Load tests ───────────────────────────────────────────────────────────
# Raw k6 per-request JSON output files are excluded — they can be multiple GBs.
# Compact run summaries (latest-*.json, history.json, data.js) ARE committed.
test/LoadTests/results/*-[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]-[0-9]*.json

# ── E2E tests ────────────────────────────────────────────────────────────
test/E2E/node_modules/
test/E2E/test-results/
test/E2E/playwright-report/
test/E2E/playwright/.cache/

# Stray Playwright output if a run is invoked from the frontend app dir
app/ControlPlane/test-results/
app/ControlPlane/playwright-report/

