<Project>
  <!-- Import root props first; test-specific overrides follow. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!--
      Test projects intentionally violate several naming/design rules:
      CA1707: xUnit test names use 'Method_Scenario_Expected' underscore convention.
      CA1711: xUnit collection fixture types conventionally end in 'Collection'.
      CA1305: Test data builders construct raw DynamoDB attribute maps; locale-
              invariant formatting is not needed for in-memory test fixtures.
      CA1822: Test stub/spy helpers are written as instance methods for symmetry
              with the interfaces they implement.
    -->
    <!--
      CA1001: Test fixture classes own disposable mock DynamoDB/HTTP infrastructure; xUnit
              manages fixture lifetime so IDisposable is not required on the test class itself.
      CA1869: Test helper serializes one-off request/response payloads; caching a
              JsonSerializerOptions instance for single-use test code adds noise without benefit.
      CA1859: TestBillingService._planTiers is typed as IReadOnlyList<string> to match the
              production interface it stubs; the string[] optimisation is irrelevant for tests.
      CA1304/CA1311: BuildSignatureHeader computes a Stripe HMAC hex string for test data only;
              locale-invariance is not a concern for fixed-format hex output.
      CA1872: BitConverter.ToString is used in BuildSignatureHeader for hex conversion; the
              Convert.ToHexStringLower alternative is available but not yet adopted here.
    -->
    <NoWarn>$(NoWarn);CA1707;CA1711;CA1305;CA1822;CA1001;CA1869;CA1859;CA1304;CA1311;CA1872</NoWarn>
  </PropertyGroup>
</Project>
