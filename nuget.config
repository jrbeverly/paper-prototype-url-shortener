<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--
      Explicit source list keeps restores hermetic: only nuget.org is consulted.
      CI runners and local machines with additional global sources will not
      accidentally resolve packages from an unexpected feed.
    -->
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <!--
      Package source mapping ensures every package is resolved from the declared
      feed, preventing dependency confusion attacks.
    -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
