{
  "name": "control-plane",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "prepare": "cd ../.. && husky",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint src/ --max-warnings 0",
    "format": "prettier --write src/",
    "generate:api": "openapi-typescript ../../docs/openapi/ControlPlane.json -o src/services/generated/api.d.ts"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@tanstack/vue-query": "^5.62.2",
    "chart.js": "^4.5.1",
    "openapi-fetch": "^0.13.4",
    "pinia": "^2.2.8",
    "qrcode": "^1.5.4",
    "vue": "^3.5.13",
    "vue-chartjs": "^5.3.3",
    "vue-router": "^4.5.0",
    "vuetify": "^3.7.6"
  },
  "lint-staged": {
    "src/**/*.{ts,vue}": [
      "prettier --write",
      "eslint --max-warnings 0"
    ],
    "src/**/*.{css,json}": "prettier --write"
  },
  "devDependencies": {
    "@tanstack/vue-query-devtools": "^5.91.0",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/eslint-config-typescript": "^14.2.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.6.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^9.32.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^16.4.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.11",
    "vite-plugin-vuetify": "^2.0.4",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  }
}
