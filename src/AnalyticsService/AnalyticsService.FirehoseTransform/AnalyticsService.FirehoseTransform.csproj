<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AWSProjectType>Lambda</AWSProjectType>
    <RootNamespace>AnalyticsService.FirehoseTransform</RootNamespace>
    <AssemblyName>AnalyticsService.FirehoseTransform</AssemblyName>
    <!-- Suppress missing-XML-doc warnings — Lambda handler is internal infrastructure, not a public library API. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.Lambda.Core" />
    <PackageReference Include="Amazon.Lambda.Serialization.SystemTextJson" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AnalyticsService.Tests" />
  </ItemGroup>

</Project>
